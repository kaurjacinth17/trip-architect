# Copy to .env.local for local development (never commit real values).
# In Vercel: Project → Settings → Environment Variables. Variables starting with VITE_ are public (sent to the
# browser); everything else is server-only and must never get a VITE_ prefix.

# ---- Site ----
VITE_SITE_URL=https://trip-architect-pi.vercel.app
# Shown on /terms and /privacy if set
VITE_CONTACT_EMAIL=

# ---- Google Maps Platform (docs/SETUP.md §1) ----
# Server only. Restricted to "Places API (New)". Used by /api functions.
GOOGLE_PLACES_SERVER_KEY=
# Public. Restricted to "Maps JavaScript API" and your site's referrers (Phase 5).
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Public. A Map ID from Google Cloud → Map Management, needed for advanced markers (Phase 5).
VITE_GOOGLE_MAPS_MAP_ID=
# Optional: lower (never raise above the free usage) the server's daily call budget per SKU.
# Defaults: autocomplete 2205, details essentials 2205, details pro 1100, text search pro 1100,
# text search / nearby / details enterprise, enterprise+atmosphere and photos 220 each.
# GOOGLE_DAILY_BUDGET_TEXT_SEARCH_ENTERPRISE=220

# Optional: your own Overpass (OpenStreetMap) instance for /api/areas; defaults to overpass-api.de with a mirror fallback.
OVERPASS_URL=

# ---- Upstash Redis: shared rate limits and daily Google budget (docs/SETUP.md §4) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Unsplash (Phase 9) ----
# Server only.
UNSPLASH_ACCESS_KEY=

# ---- Supabase (Phase 8) ----
# Public URL and anon key (safe in the browser; Row Level Security protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: used only inside /api functions for invites and role changes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel cron (Phase 8) ----
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the keep-alive job.
CRON_SECRET=

# ---- Monitoring (Phase 10) ----
VITE_SENTRY_DSN=

# ---- Legacy map tiles (until Phase 5 replaces Leaflet with Google Maps) ----
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
