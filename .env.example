# Raster tile template for Leaflet. Must allow your traffic level (see README → Map tiles).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Public URL of the deployed site, used in canonical/Open Graph tags (no trailing slash).
VITE_SITE_URL=https://trip-architect.vercel.app
