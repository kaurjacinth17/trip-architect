# Copy to .env.local for local development (never commit real values).
# In Vercel: Project → Settings → Environment Variables. Variables starting with VITE_ are public (sent to the
# browser); everything else is server-only and must never get a VITE_ prefix.

# ---- Site ----
VITE_SITE_URL=https://trip-architect-pi.vercel.app
# Shown on /terms and /privacy if set
VITE_CONTACT_EMAIL=

# ---- Maps and places: open data, no keys needed ----
# Maps: OpenStreetMap tiles. Places: OpenStreetMap via Overpass. Search: Photon. Details/addresses: Nominatim.
# Photos and summaries: Wikipedia / Wikimedia Commons. All optional overrides (e.g. your own instances, or a tile
# provider for heavier traffic: OpenStreetMap's own tile server is for light use only).
OVERPASS_URL=
PHOTON_URL=
NOMINATIM_URL=
# Public. A tile URL template such as https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILES=

# ---- Upstash Redis: shared per-visitor rate limits (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Unsplash (Phase 9) ----
# Server only.
UNSPLASH_ACCESS_KEY=

# ---- Supabase (Phase 8) ----
# Public URL and anon key (safe in the browser; Row Level Security protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: used only inside /api functions for invites and role changes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel cron (Phase 8) ----
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the keep-alive job.
CRON_SECRET=

# ---- Monitoring (Phase 10) ----
VITE_SENTRY_DSN=

